# --- required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=              # numeric; comma-separated for multiple owners, e.g. 111,222

# --- storage ---
DB_PATH=data/expenses.db

# Google Sheets mirror. Leave GOOGLE_CREDENTIALS_PATH unset to run without it.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=        # e.g. secrets/service-account.json (chmod 600)
SHEET_WORKSHEET=Expenses

# --- LLM fallback parser (optional) ---
# Primary: Qwen3 on OpenRouter's free tier. Fallback: Gemini Flash Lite.
# Both are called over an OpenAI-compatible /chat/completions API.
LLM_ENABLED=true
LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_MODEL=qwen/qwen3-235b-a22b:free
LLM_PRIMARY_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_SECONDS=20

# --- behaviour ---
TIMEZONE=Asia/Jakarta
RECAP_TIME=21:00
DEFAULT_CURRENCY=IDR
SYNC_INTERVAL_MINUTES=5
CONFIDENCE_THRESHOLD=0.7
